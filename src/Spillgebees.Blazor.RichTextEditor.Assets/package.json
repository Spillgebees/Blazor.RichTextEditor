{
  "private": true,
  "name": "spillgebees.blazor.richtexteditor.assets",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "description": "TypeScript module housing assets related to the Spillgebees.Blazor.RichTextEditor NuGet package.",
  "author": "Jason Rebelo Neves (igotinfected)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spillgebees/Blazor.RichTextEditor.git"
  },
  "bugs": {
    "url": "https://github.com/Spillgebees/Blazor.RichTextEditor/issues"
  },
  "homepage": "https://github.com/Spillgebees/Blazor.RichTextEditor#readme",
  "keywords": [],
  "scripts": {
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "clean": "rimraf ../Spillgebees.Blazor.RichTextEditor/wwwroot",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@enzedonline/quill-blot-formatter2": "^3.2.0",
    "parchment": "^3.0.0",
    "quill": "^2.0.3",
    "quill-delta": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@microsoft/dotnet-js-interop": "10.0.11",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
